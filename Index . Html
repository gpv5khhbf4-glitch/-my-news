<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>أخباري الخاصة</title>
    <style>
        :root {
            --bg-color: #121212;
            --card-bg: #1e1e1e;
            --text-main: #f5f5f5;
            --text-muted: #a0a0a0;
            --gold-accent: #d4af37;
        }
        body {
            background-color: var(--bg-color);
            color: var(--text-main);
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            margin: 0;
            padding: 20px;
        }
        .container {
            max-width: 800px;
            margin: 0 auto;
        }
        header {
            text-align: center;
            margin-bottom: 30px;
        }
        h1 { color: var(--gold-accent); margin-bottom: 20px;}
        .search-box {
            width: 100%;
            padding: 12px;
            border-radius: 8px;
            border: 1px solid #333;
            background-color: var(--card-bg);
            color: var(--text-main);
            font-size: 16px;
            box-sizing: border-box;
            margin-bottom: 20px;
        }
        .search-box:focus {
            outline: none;
            border-color: var(--gold-accent);
        }
        .tabs {
            display: flex;
            gap: 10px;
            margin-bottom: 30px;
            justify-content: center;
        }
        .tab-btn {
            background-color: var(--card-bg);
            color: var(--text-main);
            border: 1px solid #333;
            padding: 10px 20px;
            border-radius: 8px;
            cursor: pointer;
            font-size: 16px;
            transition: all 0.3s ease;
        }
        .tab-btn.active {
            background-color: var(--gold-accent);
            color: var(--bg-color);
            font-weight: bold;
            border-color: var(--gold-accent);
            box-shadow: 0 0 10px rgba(212, 175, 55, 0.3);
        }
        .news-container {
            display: flex;
            flex-direction: column;
            gap: 15px;
        }
        .news-card {
            background-color: var(--card-bg);
            padding: 20px;
            border-radius: 10px;
            border-right: 4px solid transparent;
            transition: 0.3s;
        }
        .news-card:hover {
            border-right-color: var(--gold-accent);
            transform: translateX(-5px);
        }
        .news-title {
            margin: 0 0 10px 0;
            font-size: 18px;
        }
        .news-title a {
            color: var(--text-main);
            text-decoration: none;
        }
        .news-title a:hover {
            color: var(--gold-accent);
        }
        .news-meta {
            font-size: 13px;
            color: var(--text-muted);
            display: flex;
            justify-content: space-between;
        }
    </style>
</head>
<body>

<div class="container">
    <header>
        <h1>أخباري | News</h1>
        <input type="text" id="searchInput" class="search-box" placeholder="ابحث في الأخبار (مثال: الذكاء الاصطناعي)..." onkeyup="filterNews()">
        
        <div class="tabs">
            <button class="tab-btn active" onclick="changeTab('politics', this)">🌍 السياسة</button>
            <button class="tab-btn" onclick="changeTab('tech', this)">💻 التكنولوجيا</button>
            <button class="tab-btn" onclick="changeTab('ai', this)">🤖 الذكاء الاصطناعي</button>
        </div>
    </header>

    <div class="news-container" id="newsContainer">
        <p style="text-align:center; color: var(--text-muted);">جاري تحميل الأخبار...</p>
    </div>
</div>

<script>
    let allNews = {};
    let currentCategory = 'politics';

    fetch('news.json')
        .then(response => response.json())
        .then(data => {
            allNews = data;
            renderNews();
        })
        .catch(error => {
            document.getElementById('newsContainer').innerHTML = '<p style="text-align:center; color: var(--text-muted);">جاري انتظار التحديث الأول للأخبار بنص الليل...</p>';
        });

    function changeTab(category, btnElement) {
        currentCategory = category;
        document.querySelectorAll('.tab-btn').forEach(btn => btn.classList.remove('active'));
        btnElement.classList.add('active');
        document.getElementById('searchInput').value = '';
        renderNews();
    }

    function filterNews() {
        renderNews(document.getElementById('searchInput').value);
    }

    function renderNews(searchQuery = '') {
        const container = document.getElementById('newsContainer');
        container.innerHTML = '';

        let articles = allNews[currentCategory] || [];
        
        if (searchQuery) {
            articles = articles.filter(article => 
                article.title.includes(searchQuery) || article.summary.includes(searchQuery)
            );
        }

        if (articles.length === 0) {
            container.innerHTML = '<p style="text-align:center; color: var(--text-muted);">لا توجد أخبار حالياً أو لم يتم العثور على نتائج.</p>';
            return;
        }

        articles.forEach(article => {
            const card = document.createElement('div');
            card.className = 'news-card';
            card.innerHTML = `
                <h3 class="news-title"><a href="${article.link}" target="_blank">${article.title}</a></h3>
                <div class="news-meta">
                    <span>🕒 ${article.time}</span>
                    <span>⏳ وقت القراءة: ~${article.read_time} دقائق</span>
                </div>
            `;
            container.appendChild(card);
        });
    }
</script>

</body>
</html>
